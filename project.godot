; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Night Shift"
config/description="First-person co-op light horror: night security at a high school."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/version="1.0.0"
config/icon="res://icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="NightShift"
boot_splash/bg_color=Color(0.02, 0.03, 0.06, 1)
boot_splash/show_image=true
boot_splash/image="res://splash.png"
boot_splash/fullsize=true

[night_shift]

credits/author="Travis700"
steam/app_id=480

[audio]

driver/enable_input=true

[autoload]

Controls="*res://scripts/controls.gd"
Profile="*res://scripts/profile.gd"
SteamService="*res://scripts/steam_service.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=1024
window/size/min_height=576

[rendering]

anti_aliasing/quality/msaa_3d=2
